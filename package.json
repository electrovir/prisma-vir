{
    "name": "prisma-vir",
    "version": "2.3.3",
    "description": "Helpers for Prisma.",
    "keywords": [
        "prisma",
        "client",
        "sqlite",
        "postgres",
        "migrations",
        "database"
    ],
    "homepage": "https://github.com/electrovir/prisma-vir",
    "bugs": {
        "url": "https://github.com/electrovir/prisma-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/prisma-vir.git"
    },
    "license": "(MIT or CC0 1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "prisma-branded-fields": "./dist/prisma-generators/branded-fields.generator.js",
        "prisma-shapes": "./dist/prisma-generators/shapes.generator.js",
        "prisma-string-dates": "./dist/prisma-generators/string-dates.generator.js"
    },
    "scripts": {
        "compile": "npm run init && virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "init": "npm run install --prefix node_modules/better-sqlite3",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "npm run init && virmator test node --test-concurrency=1",
        "test:all": "npm run compile && npm run test:coverage && runstorm --names spelling,format,docs,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "virmator test node coverage --test-concurrency=1",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "virmator test node update --test-concurrency=1"
    },
    "dependencies": {
        "@augment-vir/assert": "^31.57.5",
        "@augment-vir/common": "^31.57.5",
        "@augment-vir/node": "^31.57.5",
        "@paralleldrive/cuid2": "^3.0.6",
        "fsm-vir": "^3.0.0",
        "terminate": "^2.8.0",
        "url-vir": "^2.1.7"
    },
    "devDependencies": {
        "@augment-vir/test": "^31.57.5",
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^9.39.2",
        "@prisma/adapter-better-sqlite3": "^6.19.0",
        "@prisma/adapter-pg": "^6.19.0",
        "@prisma/client": "^6.19.0",
        "@prisma/config": "^6.19.0",
        "@prisma/dmmf": "^6.19.0",
        "@prisma/generator-helper": "^6.19.0",
        "@stylistic/eslint-plugin": "^5.7.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^25.0.3",
        "@typescript-eslint/eslint-plugin": "^8.50.1",
        "c8": "^10.1.3",
        "cspell": "^9.4.0",
        "date-vir": "^8.1.0",
        "dependency-cruiser": "^17.3.6",
        "diff": "^8.0.2",
        "esbuild": "^0.27.2",
        "eslint": "^9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^62.0.0",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.4.0",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^3.0.5",
        "eslint-plugin-unicorn": "^62.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.3",
        "npm-check-updates": "^19.3.1",
        "object-shape-tester": "^6.11.0",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.1",
        "prettier-plugin-jsdoc": "^1.8.0",
        "prettier-plugin-multiline-arrays": "^4.1.3",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^2.5.20",
        "prettier-plugin-sort-json": "^4.1.1",
        "prettier-plugin-toml": "^2.0.6",
        "prisma": "^6.19.0",
        "prisma-pglite": "^2.0.2",
        "type-fest": "^5.3.1",
        "typedoc": "^0.28.15",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.50.1",
        "virmator": "^14.4.2"
    },
    "peerDependencies": {
        "@prisma/adapter-better-sqlite3": "<7",
        "@prisma/adapter-pg": "<7",
        "@prisma/client": "<7",
        "@prisma/config": "<7",
        "@prisma/generator-helper": "<7",
        "date-vir": "*",
        "object-shape-tester": ">=6.7",
        "prisma": "<7",
        "prisma-pglite": ">=2"
    },
    "engines": {
        "node": ">=22"
    }
}
