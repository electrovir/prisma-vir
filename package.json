{
    "name": "prisma-vir",
    "version": "4.0.1",
    "description": "Helpers for Prisma.",
    "keywords": [
        "prisma",
        "client",
        "sqlite",
        "postgres",
        "migrations",
        "database"
    ],
    "homepage": "https://github.com/electrovir/prisma-vir",
    "bugs": {
        "url": "https://github.com/electrovir/prisma-vir/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/electrovir/prisma-vir.git"
    },
    "license": "(MIT OR CC0-1.0)",
    "author": {
        "name": "electrovir",
        "url": "https://github.com/electrovir"
    },
    "sideEffects": false,
    "type": "module",
    "main": "src/index.ts",
    "module": "src/index.ts",
    "types": "src/index.ts",
    "bin": {
        "prisma-branded-fields": "./dist/prisma-generators/branded-fields.generator.js",
        "prisma-shapes": "./dist/prisma-generators/shapes.generator.js",
        "prisma-string-dates": "./dist/prisma-generators/string-dates.generator.js"
    },
    "scripts": {
        "compile": "npm run init && virmator compile",
        "docs": "virmator docs",
        "format": "virmator format",
        "init": "npm run install --prefix node_modules/better-sqlite3",
        "lint": "virmator lint fix",
        "publish": "virmator publish npm run test:all",
        "test": "npm run init && virmator test node --test-concurrency=1",
        "test:all": "npm run compile && runstorm --names spelling,format,docs,deps,lint \"npm run test:spelling\" \"npm run test:format\" \"npm run test:docs\" \"npm run test:deps\" \"npm run test:lint\"",
        "test:coverage": "virmator test node coverage --test-concurrency=1",
        "test:deps": "virmator deps check",
        "test:docs": "virmator docs check",
        "test:format": "virmator format check",
        "test:lint": "virmator lint",
        "test:spelling": "virmator spellcheck",
        "test:update": "virmator test node update --test-concurrency=1"
    },
    "overrides": {
        "@hono/node-server": ">=1.19.13",
        "esbuild": "^0.28.1"
    },
    "dependencies": {
        "@augment-vir/assert": "^32.2.1",
        "@augment-vir/common": "^32.2.1",
        "@augment-vir/node": "^32.2.1",
        "@augment-vir/test": "^32.2.1",
        "@paralleldrive/cuid2": "^3.3.0",
        "@types/pg": "^8.20.0",
        "fsm-vir": "^3.0.0",
        "terminate": "^2.8.0",
        "url-vir": "^2.1.10"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.6",
        "@eslint/js": "^10.0.1",
        "@prisma/adapter-better-sqlite3": "^7.9.0",
        "@prisma/adapter-pg": "^7.9.0",
        "@prisma/client": "^7.9.0",
        "@prisma/config": "^7.9.0",
        "@prisma/dmmf": "^7.9.0",
        "@prisma/generator-helper": "^7.9.0",
        "@stylistic/eslint-plugin": "^5.10.0",
        "@stylistic/eslint-plugin-ts": "^4.4.1",
        "@types/better-sqlite3": "^7.6.13",
        "@types/node": "^26.1.1",
        "@typescript-eslint/eslint-plugin": "^8.65.0",
        "c8": "^12.0.0",
        "cspell": "^10.0.1",
        "date-vir": "^8.6.2",
        "dependency-cruiser": "^18.1.0",
        "diff": "^9.0.0",
        "esbuild": "^0.28.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-jsdoc": "^63.2.2",
        "eslint-plugin-monorepo-cop": "^1.0.2",
        "eslint-plugin-playwright": "^2.10.5",
        "eslint-plugin-prettier": "^5.5.6",
        "eslint-plugin-require-extensions": "^0.1.3",
        "eslint-plugin-sonarjs": "^4.2.0",
        "eslint-plugin-unicorn": "^72.0.0",
        "istanbul-smart-text-reporter": "^1.1.5",
        "markdown-code-example-inserter": "^3.0.6",
        "npm-check-updates": "^22.2.9",
        "object-shape-tester": "^6.14.1",
        "prettier": "~3.3.3",
        "prettier-plugin-interpolated-html-tags": "^2.0.2",
        "prettier-plugin-jsdoc": "^1.8.1",
        "prettier-plugin-multiline-arrays": "^4.1.11",
        "prettier-plugin-organize-imports": "^4.3.0",
        "prettier-plugin-packagejson": "^3.0.2",
        "prettier-plugin-sort-json": "^4.2.0",
        "prettier-plugin-toml": "^2.0.6",
        "prisma": "^7.9.0",
        "prisma-pglite": "^3.0.0",
        "typedoc": "^0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.65.0",
        "virmator": "^14.30.1"
    },
    "peerDependencies": {
        "@prisma/adapter-better-sqlite3": ">=7",
        "@prisma/adapter-pg": ">=7",
        "@prisma/client": ">=7",
        "@prisma/config": ">=7",
        "@prisma/generator-helper": ">=7",
        "date-vir": "*",
        "object-shape-tester": ">=6.7",
        "prisma": ">=7",
        "prisma-pglite": ">=3"
    },
    "engines": {
        "node": ">=22"
    }
}
