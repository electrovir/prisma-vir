generator jsClientStringDates {
    provider        = "prisma-client"
    previewFeatures = ["strictUndefinedChecks", "relationJoins"]
    output          = "./generated"
    engineType      = "client"
    moduleFormat    = "esm"
}

datasource dbStringDates {
    provider = "postgres"
}

enum FieldKind {
    Date
    Text
}

model FieldStringDates {
    id        String    @id @default(cuid(2))
    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt

    kind      FieldKind
    birthDate DateTime  @dbStringDates.Date
    endDate   DateTime? @dbStringDates.Date
}
