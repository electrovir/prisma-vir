generator jsClientSimple {
    provider        = "prisma-client"
    previewFeatures = ["strictUndefinedChecks", "relationJoins"]
    output          = "./generated"
    engineType      = "client"
    moduleFormat    = "esm"
}

datasource dbSimple {
    provider = "sqlite"
}

model UserSimple {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    email    String
    password String
}
