generator jsClientMulti {
    provider        = "prisma-client"
    previewFeatures = ["strictUndefinedChecks", "relationJoins"]
    output          = "./generated"
    engineType      = "client"
    moduleFormat    = "esm"
}

datasource dbMulti {
    provider = "sqlite"
}

model UserMulti {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    /// This id is used for tracking extra stuff.
    /// @branded()
    extraId  String
    email    String
    password String
    authorOf PostMulti[] @relation("authorRelation")
    editorOf PostMulti[] @relation("editorRelation")
}

model PostMulti {
    id        String   @id @default(cuid(2))
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    content String

    author   UserMulti @relation(fields: [authorId], references: [id], name: "authorRelation")
    editor   UserMulti @relation(fields: [editorId], references: [id], name: "editorRelation")
    authorId String
    editorId String
}
